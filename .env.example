DATABASE_URL="postgresql://postgres:postgres@localhost:5432/employee_portal?schema=public"

# Required. Signed Hmac session cookie secret. Generate a fresh value in production.
SESSION_SECRET="change-me-to-a-long-random-hex-string"

# AI provider boundary: only "dev-stub" is implemented so far.
AI_PROVIDER="dev-stub"

# Embedding provider boundary + vector dimensions for pgvector.
EMBEDDING_PROVIDER="dev-stub"
EMBEDDING_DIMENSIONS="384"

# Storage provider: "local" writes under ./uploads.
STORAGE_PROVIDER="local"

# Resend transactional email provider.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="onboarding@resend.dev"
EMAIL_PROVIDER="resend"

# Background worker tuning. N = max jobs processed at once; keep it inside the
# external provider's rate limit. STUCK_TIMEOUT_MS must exceed the longest
# possible job run, or an in-flight job would be re-claimed by another worker.
# SWEEP_INTERVAL_MS is how often the worker looks for stuck PROCESSING rows.
# Retry backoff = BASE_BACKOFF_MS * 2^attempts + random(0..JITTER_MS).
CONCURRENCY_CAP=5
POLL_INTERVAL_MS=200
SWEEP_INTERVAL_MS=10000
STUCK_TIMEOUT_MS=300000
BASE_BACKOFF_MS=1000
JITTER_MS=500